# Copie este arquivo para ".env" (mesma pasta) e ajuste os valores.
# Variáveis já definidas no ambiente têm prioridade sobre o .env.
# ATENÇÃO: comentários só em linhas próprias (não coloque "# ..." depois do valor).

# dev = expõe o código de confirmação na resposta e habilita os botões de simulação do Painel
APP_ENV=dev

# ---------------- Banco ----------------
# mysql | sqlite   (sqlite = sem servidor; arquivos em data/)
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
CLINICA_DB_NAME=sdm_clinica
GOVERNO_DB_NAME=sdm_governo

# ---------------- Segurança (API da clínica) ----------------
CLINICA_SECRET_KEY=troque-esta-chave-por-uma-longa-e-aleatoria
# validade do login, em minutos
TOKEN_TTL_MIN=120
# validade do código de confirmação, em minutos
CODIGO_TTL_MIN=15
# tentativas erradas antes de bloquear o código (HTTP 429)
CODIGO_MAX_TENTATIVAS=5

# ---------------- API pública ViaCEP ----------------
VIACEP_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT_S=3

# ---------------- API governamental SIMULADA ----------------
GOV_URL=http://127.0.0.1:5001
# a mesma chave precisa valer nos dois serviços
GOV_API_KEY=chave-demo-governo
GOV_TIMEOUT_S=3
# limite do reenvio AUTOMÁTICO (o reenvio manual é sempre permitido)
GOV_MAX_TENTATIVAS=5
# 1 = thread de reenvio automático; 0 = somente reenvio manual
AUTO_RETRY=1
AUTO_RETRY_INTERVALO_S=30
# 1 = botões de simulação de falhas no Painel (padrão: ligado em APP_ENV=dev)
DEMO_SIMULACAO=1

# ---------------- Portas ----------------
CLINICA_PORT=5000
GOVERNO_PORT=5001
