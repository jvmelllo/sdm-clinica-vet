erDiagram
    ESPECIE ||--o{ RACA : "possui"
    ESPECIE ||--o{ ANIMAL : "classifica"
    RACA |o--o{ ANIMAL : "define (opcional)"
    ENDERECO ||--o{ TUTOR : "localiza"
    TUTOR ||--o{ ANIMAL : "é responsável por"
    ANIMAL ||--o{ VINCULO_MICROCHIP : "recebe"
    VETERINARIO ||--o{ VINCULO_MICROCHIP : "realiza"
    ANIMAL ||--o{ CONSULTA : "é atendido em"
    VETERINARIO ||--o{ CONSULTA : "atende"
    ANIMAL ||--o{ VACINA : "recebe"
    VETERINARIO ||--o{ VACINA : "aplica"
    ANIMAL ||--o{ INTEGRACAO_GOVERNO : "é sincronizado por"
    VACINA |o--o| INTEGRACAO_GOVERNO : "gera (se antirrábica)"
    VINCULO_MICROCHIP |o--o{ INTEGRACAO_GOVERNO : "identifica"
    VETERINARIO ||--o{ CODIGO_CONFIRMACAO : "confirma senha com"
    VETERINARIO ||--o{ SESSAO_LOGIN : "abre"

    ESPECIE {
        int id PK
        string nome UK
        string descricao
        string situacao "ATIVA|INATIVA"
    }
    RACA {
        int id PK
        string nome "UK com especie_id"
        string descricao
        int especie_id FK
        string situacao "ATIVA|INATIVA"
    }
    ENDERECO {
        int id PK
        string cep
        string logradouro
        string numero
        string complemento
        string bairro
        string cidade
        string uf
        string codigo_ibge
    }
    TUTOR {
        int id PK
        string nome_completo
        string cpf UK
        date data_nascimento
        string email
        string telefone
        int endereco_id FK
        datetime data_cadastro
        string situacao "ATIVO|INATIVO"
    }
    VETERINARIO {
        int id PK
        string nome_completo
        string cpf UK
        string crmv_numero "UK com crmv_uf"
        string crmv_uf
        string email UK
        string telefone
        string senha_hash
        boolean senha_confirmada
        datetime senha_confirmada_em
        datetime data_cadastro
        string situacao "ATIVO|INATIVO"
        datetime ultimo_acesso_em
    }
    ANIMAL {
        int id PK
        string nome
        date data_nascimento
        int idade_estimada_meses
        string sexo "MACHO|FEMEA"
        string cor
        decimal peso_atual
        int tutor_id FK
        int especie_id FK
        int raca_id FK "FK composta (raca_id, especie_id)"
        string situacao "ATIVO|INATIVO|OBITO"
        datetime data_cadastro
    }
    VINCULO_MICROCHIP {
        int id PK
        int animal_id FK
        string codigo_microchip UK
        int veterinario_id FK
        datetime data_vinculo
        string situacao "ATIVO|SUBSTITUIDO"
        boolean vigente "UK com animal_id"
        datetime data_substituicao
        string motivo_substituicao
    }
    CONSULTA {
        int id PK
        int animal_id FK
        int veterinario_id FK
        datetime data_hora
        string motivo
        text anamnese
        text sintomas
        text diagnostico
        text tratamento
        text prescricao_medicamentos
        decimal peso_kg
        decimal temperatura_c
        text observacoes
        string situacao "AGENDADA|REALIZADA|CANCELADA|NAO_COMPARECEU"
    }
    VACINA {
        int id PK
        int animal_id FK
        int veterinario_id FK
        string nome_vacina
        string tipo_vacina "ANTIRRABICA|POLIVALENTE|..."
        boolean antirrabica
        string fabricante
        string numero_lote
        date data_aplicacao
        string dose
        string via_aplicacao
        date data_proxima_dose
        date validade_lote
        text observacoes
        string situacao "AGENDADA|APLICADA|CANCELADA"
    }
    INTEGRACAO_GOVERNO {
        int id PK
        int animal_id FK
        int vacina_id FK "UK (1 comunicação por vacina)"
        int vinculo_microchip_id FK
        string tipo_operacao "CADASTRO_ANIMAL|ATUALIZACAO_ANIMAL|VACINACAO_ANTIRRABICA"
        string protocolo_externo
        string chave_idempotencia UK
        string situacao "PENDENTE|ENVIADA|CONFIRMADA|FALHA"
        datetime solicitada_em
        datetime respondida_em
        datetime ultima_tentativa_em
        int tentativas
        string mensagem_erro
        text payload_enviado
    }
    CODIGO_CONFIRMACAO {
        int id PK
        int veterinario_id FK
        string codigo_hash
        datetime criado_em
        datetime expira_em
        datetime utilizado_em
        int tentativas
    }
    SESSAO_LOGIN {
        int id PK
        string jti UK
        int veterinario_id FK
        datetime criada_em
        datetime expira_em
        datetime revogada_em
    }
