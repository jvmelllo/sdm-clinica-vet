flowchart LR
    subgraph NAV["Navegador do veterinário"]
        FE["Frontend web<br/>HTML + CSS + JS (módulos ES)<br/>servido pela API da clínica"]
    end

    subgraph CLI["API privada da clínica — Flask :5000"]
        direction TB
        RT["Rotas REST /api/*<br/>(autenticação JWT)"]
        SV["Serviços de negócio<br/>(tutores, animais, microchip,<br/>consultas, vacinas, integração)"]
        VAL["Validadores<br/>(CPF, CEP, microchip, datas)"]
        CLIAPI["Clientes HTTP<br/>ViaCEP e Governo"]
        RT --> VAL --> SV --> CLIAPI
    end

    subgraph GOV["API governamental SIMULADA — Flask :5001"]
        GRT["Rotas /api/governo/*<br/>(X-API-Key, Idempotency-Key)"]
        GSV["Validação, duplicidade,<br/>protocolos, simulação de falhas"]
        GRT --> GSV
    end

    DBC[("MySQL<br/>sdm_clinica")]
    DBG[("MySQL<br/>sdm_governo")]
    VIACEP["ViaCEP<br/>API pública real"]
    EMAIL["E-mail simulado<br/>(arquivo de log)"]

    FE -- "HTTP/JSON + Bearer token" --> RT
    SV --> DBC
    SV -. "código de confirmação" .-> EMAIL
    CLIAPI -- "GET /ws/{cep}/json (timeout 3 s)" --> VIACEP
    CLIAPI -- "POST/PUT + Idempotency-Key (timeout 3 s)" --> GRT
    GSV --> DBG
